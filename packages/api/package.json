{
  "name": "@sentient/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write .",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/s3-request-presigner": "^3.1057.0",
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "1.1.48",
    "@langchain/langgraph": "^1.3.3",
    "@langchain/openai": "^1.4.7",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "@sentient/agents": "workspace:*",
    "@sentient/billing": "workspace:*",
    "@sentient/database": "workspace:*",
    "@sentient/events": "workspace:*",
    "@sentient/graph": "workspace:*",
    "@sentient/queue": "workspace:*",
    "@sentient/realtime": "workspace:*",
    "@sentient/shared": "workspace:*",
    "@sentient/webhooks": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/multer": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "5.77.2",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "8.2.0",
    "ioredis": "5.10.1",
    "jsonwebtoken": "^9.0.3",
    "langchain": "1.4.2",
    "morgan": "1.10.1",
    "multer": "^2.1.1",
    "multer-s3": "^3.0.1",
    "neo4j-driver": "6.0.1",
    "openai": "^6.39.1",
    "p-limit": "^7.3.0",
    "p-retry": "^8.0.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "pg-listen": "^1.7.0",
    "pgvector": "^0.3.0",
    "rate-limit-redis": "^5.0.0",
    "resend": "^6.12.4",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9",
    "socket.io": "4.8.3",
    "tiktoken": "^1.0.22",
    "yjs": "^13.6.31",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "1.9.10",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "prisma": "7.8.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "4.22.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
